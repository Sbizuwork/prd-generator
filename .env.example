# Copy this file to .env and fill in your key, or set the variable
# in your hosting platform's Secrets / Environment settings.

# OpenRouter API key (https://openrouter.ai/keys)
# Without this key the app runs in demo mode with sample outputs.
OPENROUTER_API_KEY=

# Optional: override the default models used for each pass.
# DRAFTER_MODEL=openai/gpt-4o
# CRITIC_MODEL=anthropic/claude-sonnet-4
